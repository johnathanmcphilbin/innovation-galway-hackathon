# Postgres on Hack Club Orchard. Sign-ups are stored here and are never written to Airtable.
DATABASE_URL=postgres://user:password@localhost:5432/innovation_galway

# Personal access token with permission to create records in this base only.
AIRTABLE_API_KEY=

# Innovation Galway YSWS base. Do not point submissions at any other base.
AIRTABLE_BASE_ID=appInkJZdtOT67t8l

# Table name. Table id: tbloBMHxgUSH9zrkg.
AIRTABLE_TABLE=YSWS Project Submission

# Password for /admin. Use a long random value.
ADMIN_PASSWORD=

# Orchard injects PORT. 3000 is only the local default.
PORT=3000
