# Required for /submit. The signups table migration still runs and does not drop data.
DATABASE_URL=postgres://user:password@localhost:5432/innovation_galway

# Personal access token with permission to create records in this base only.
AIRTABLE_API_KEY=

# Innovation Galway YSWS base. Do not point submissions at any other base.
AIRTABLE_BASE_ID=appInkJZdtOT67t8l

# Table name. Table id: tbloBMHxgUSH9zrkg.
AIRTABLE_TABLE=YSWS Project Submission

# Orchard injects PORT. 3000 is only the local default.
PORT=3000

# Hack Club Auth. Create an app at https://auth.hackclub.com and register this
# exact redirect URI (production):
#   https://galway.hackclub.com/auth/callback
# Local example: http://127.0.0.1:3000/auth/callback
# The app should allow scopes: openid profile email name birthdate address.
# birthdate and address are HQ-only, so the app needs the hq_official trust
# level or Hack Club Auth rejects the whole sign-in. Optional HCA_SCOPES can
# drop those two without a code change.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
HCA_REDIRECT_URI=https://galway.hackclub.com/auth/callback

# Signs the session cookie. If unset, the app uses HCA_CLIENT_SECRET.
SESSION_SECRET=

# Organisers who land on /admin after sign-in. johnny@hackclub.com is always included.
ADMIN_EMAILS=

# Off unless this is exactly true. Approve still updates Postgres either way.
SYNC_APPROVED_TO_AIRTABLE=
